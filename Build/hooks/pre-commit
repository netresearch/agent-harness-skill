#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# SPDX-FileCopyrightText: Netresearch DTT GmbH
set -euo pipefail

# Pre-commit hook: basic checks before committing

# Check SKILL.md body size: the same limit and the same count as
# validate-skill.sh in netresearch/skill-repo-skill — at most 500 lines after
# the closing front-matter delimiter.
if [ -f skills/agent-harness/SKILL.md ]; then
  LINES=$(awk 'BEGIN{d=0} /^---$/{d++; next} d>=2{print}' skills/agent-harness/SKILL.md | wc -l)
  if [ "$LINES" -gt 500 ]; then
    echo "ERROR: SKILL.md body exceeds 500 lines ($LINES lines)"
    exit 1
  fi
fi

# Check for trailing whitespace and conflict markers in staged changes
if ! git diff --cached --check; then
  echo "ERROR: staged changes contain whitespace errors (listed above)"
  exit 1
fi

echo "Pre-commit checks passed"
